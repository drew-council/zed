[
  {
    // The review editor has a line cursor: character and word motions do nothing.
    "context": "CodeReview > Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "v": "vim::ToggleVisualLine",
      "ctrl-v": "vim::ToggleVisualLine",
      "ctrl-q": "vim::ToggleVisualLine",
      "h": "code_review::ScrollLeft",
      "left": "code_review::ScrollLeft",
      "l": "code_review::ScrollRight",
      "right": "code_review::ScrollRight",
      "w": null,
      "shift-w": null,
      "b": null,
      "shift-b": null,
      "e": null,
      "shift-e": null,
      "g e": null,
      "g shift-e": null,
      "f": null,
      "shift-f": null,
      "t": null,
      "shift-t": null,
      ";": null,
      ",": null,
      "^": null,
      "$": null,
      "|": null,
      "home": null,
      "end": null,
      "g 0": null,
      "g ^": null,
      "g $": null,
      "g home": null,
      "g end": null,
      "g shift-m": null,
      "space": null,
      "backspace": null,
      "(": null,
      ")": null,
      "%": null,
      "*": null,
      "#": null,
      "g *": null,
      "g #": null,
    },
  },
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "] f": "code_review::NextFile",
      "[ f": "code_review::PreviousFile",
      "}": "code_review::NextFile",
      "{": "code_review::PreviousFile",
      "] u": "code_review::NextUnreviewedFile",
      "[ u": "code_review::PreviousUnreviewedFile",
      "e": "code_review::OpenFileAtCursor",
      "; f": "code_review::ToggleSingleFileMode",
      "; e": "code_review::TogglePanel",
      "; h": "code_review::FocusPanel",
      "; l": "code_review::FocusDiff",
      // Nothing may enter insert mode on the read-only diff (comments will rebind some of these).
      "i": null,
      "a": null,
      "shift-i": null,
      "shift-a": null,
      "o": null,
      "shift-o": null,
      "s": null,
      "shift-s": null,
      "c": null,
      "shift-c": null,
      "r": null,
      "shift-r": null,
      "g i": null,
      "insert": null,
    },
  },
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "i": null,
      "a": null,
      "c": null,
      "s": null,
      "shift-s": null,
      "r": null,
      "shift-r": null,
      "shift-i": null,
      "shift-a": null,
      "g shift-i": null,
      "g shift-a": null,
    },
  },
  {
    "context": "ReviewPanel",
    "bindings": {
      "; e": "code_review::TogglePanel",
      "; l": "code_review::FocusDiff",
    },
  },
]
