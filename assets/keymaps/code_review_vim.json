[
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "] f": "code_review::NextFile",
      "[ f": "code_review::PreviousFile",
      "] u": "code_review::NextUnreviewedFile",
      "[ u": "code_review::PreviousUnreviewedFile",
      "; f": "code_review::ToggleSingleFileMode",
      "; t": "code_review::ToggleHeader",
      "; e": "code_review::TogglePanel",
      "; h": "code_review::FocusPanel",
      "; l": "code_review::FocusDiff",
      // Nothing may enter insert mode on the read-only diff (comments rebind `i`, `c` and
      // `shift-c` below). Motions, text objects and operators other than these stay vim's.
      "i": null,
      "a": null,
      "shift-i": null,
      "shift-a": null,
      "o": null,
      "shift-o": null,
      "s": null,
      "shift-s": null,
      "c": null,
      "shift-c": null,
      "r": "code_review::ToggleFileReviewed",
      "shift-r": "code_review::ToggleHunkReviewed",
      "] c": "code_review::NextHunk",
      "[ c": "code_review::PreviousHunk",
      // The pull requests up and down a stack (gh-stack's `up`/`down`).
      "] s": "code_review::NextPullRequestInStack",
      "[ s": "code_review::PreviousPullRequestInStack",
      "g i": null,
      "insert": null,
    },
  },
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "c": "code_review::AddComment",
      "s": null,
      "shift-s": null,
      "r": null,
      "shift-r": null,
      "shift-i": null,
      "shift-a": null,
      "g shift-i": null,
      "g shift-a": null,
    },
  },
  {
    // Comments. After the block above: its `i` and `c` nulls rank lower, so these win, and a
    // propagated `i` (no comment at the cursor) still doesn't reach vim's insert mode.
    "context": "CodeReview > Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "c": "code_review::AddComment",
      "shift-c": "code_review::AddFileComment",
      "; c": "code_review::AddReviewComment",
      "i": "code_review::EditComment",
      "enter": "code_review::EditComment",
      "] t": "code_review::NextComment",
      "[ t": "code_review::PreviousComment",
      "; y": "code_review::CopyReviewAsMarkdown",
      "; shift-y": "code_review::CopyCommentAtCursor",
      "; s": "code_review::SubmitReview",
    },
  },
  {
    // `dd`, as vim's second `d`: a `d d` binding would hold back every `d` until the next key,
    // and replaying it then misses vim's operator bindings (`d u`, `d o`, …).
    "context": "CodeReview > Editor && mode == full && vim_operator == d && !menu",
    "bindings": {
      "d": "code_review::DeleteComment",
    },
  },
  {
    // A comment being edited. Vim's insert mode binds `ctrl-s` to signature help.
    "context": "ReviewComment > Editor",
    "bindings": {
      // Last, so that the Save button shows it.
      "ctrl-s": "code_review::SaveComment",
      "ctrl-enter": "code_review::SaveComment",
    },
  },
  {
    // In insert mode `tab` inserts a tab.
    "context": "ReviewComment > Editor && VimControl && vim_mode == normal && !menu",
    "bindings": {
      "tab": "code_review::CycleCommentType",
      "shift-tab": "code_review::CycleCommentTypeBackward",
    },
  },
  {
    // `not_editing`: `;` typed into a filter prompt must not start `; l`.
    "context": "ReviewPanel && not_editing",
    "bindings": {
      "; e": "code_review::TogglePanel",
      "; l": "code_review::FocusDiff",
      // Already here: without it, `;` would do nothing and `h` collapse a directory.
      "; h": "code_review::FocusPanel",
      // vim's `space f`, `space w …` would otherwise keep `space` pending.
      "space": "code_review::ToggleSelectedDirectory",
      "r": "code_review::ToggleFileReviewed",
      "j": "vim::MenuSelectNext",
      "k": "vim::MenuSelectPrevious",
      "down": "vim::MenuSelectNext",
      "up": "vim::MenuSelectPrevious",
      "0": ["vim::Number", 0],
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9],
    },
  },
]
