[
  {
    // The review editor has a line cursor: character and word motions do nothing.
    "context": "CodeReview > Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "v": "vim::ToggleVisualLine",
      "ctrl-v": "vim::ToggleVisualLine",
      "ctrl-q": "vim::ToggleVisualLine",
      "h": null,
      "left": null,
      "l": null,
      "right": null,
      "w": null,
      "shift-w": null,
      "b": null,
      "shift-b": null,
      "e": null,
      "shift-e": null,
      "g e": null,
      "g shift-e": null,
      "f": null,
      "shift-f": null,
      "t": null,
      "shift-t": null,
      ";": null,
      ",": null,
      "^": null,
      "$": null,
      "|": null,
      "home": null,
      "end": null,
      "g 0": null,
      "g ^": null,
      "g $": null,
      "g home": null,
      "g end": null,
      "g shift-m": null,
      "space": null,
      "backspace": null,
      "(": null,
      ")": null,
      "%": null,
      "*": null,
      "#": null,
      "g *": null,
      "g #": null,
    },
  },
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "; h": "code_review::ToggleFocus",
      // Nothing may enter insert mode on the read-only diff (comments will rebind some of these).
      "i": null,
      "a": null,
      "shift-i": null,
      "shift-a": null,
      "o": null,
      "shift-o": null,
      "s": null,
      "shift-s": null,
      "c": null,
      "shift-c": null,
      "r": null,
      "shift-r": null,
      "g i": null,
      "insert": null,
    },
  },
  {
    "context": "CodeReview > Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "i": null,
      "a": null,
      "c": null,
      "s": null,
      "shift-s": null,
      "r": null,
      "shift-r": null,
      "shift-i": null,
      "shift-a": null,
      "g shift-i": null,
      "g shift-a": null,
    },
  },
  {
    "context": "ReviewPanel",
    "bindings": {
      "; l": "code_review::ToggleFocus",
    },
  },
]
