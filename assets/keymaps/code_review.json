[
  {
    // `tab` toggles the commit under the cursor and moves on, so a range is a run of `tab`s.
    // `ctrl-r` (deeper than the workspace's `projects::OpenRecent`) switches the pull requests
    // between open ones and those requesting your review.
    "context": "StartReview > Picker > Editor",
    "bindings": {
      "tab": "picker::MultiSelectNext",
      "ctrl-r": "code_review::EditPullRequestSearch",
    },
  },
  {
    // The review panel's file tree. Enter, Escape and the arrow keys come from the global
    // `menu::*` bindings.
    "context": "ReviewPanel && not_editing",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "h": "code_review::CollapseSelectedEntry",
      "left": "code_review::CollapseSelectedEntry",
      "l": "code_review::ExpandSelectedEntry",
      "right": "code_review::ExpandSelectedEntry",
      "space": "code_review::ToggleSelectedDirectory",
      "r": "code_review::ToggleFileReviewed",
      "i": "code_review::EditIncludeFilter",
      "e": "code_review::EditExcludeFilter",
      "shift-i": "code_review::ClearIncludeFilter",
      "shift-e": "code_review::ClearExcludeFilter",
      "/": "code_review::SearchPaths",
      "n": "code_review::SelectNextMatch",
      "shift-n": "code_review::SelectPreviousMatch",
      "g g": "menu::SelectFirst",
      "shift-g": "menu::SelectLast",
    },
  },
  {
    // The submit review modal: the arrows (and `tab`) choose Comment, Approve or Request
    // Changes.
    "context": "SubmitReviewModal",
    "bindings": {
      "left": "menu::SelectPrevious",
      "right": "menu::SelectNext",
    },
  },
  {
    // A comment being edited in a review. Auto-height editors have no `enter` binding of their
    // own; vim's normal mode binds it later, so this only applies while typing.
    "context": "ReviewComment > Editor",
    "bindings": {
      // Last, so that the Save button shows it.
      "ctrl-s": "code_review::SaveComment",
      "ctrl-enter": "code_review::SaveComment",
      "enter": "editor::Newline",
    },
  },
]
